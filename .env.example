# --- API / CLOUD ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your_service_or_backend_key
SENTINELA_SUPABASE_KEY=
CORS_ORIGINS=*

# --- ADMIN ---
SENTINELA_ADMIN_TOTP_SECRET=your_totp_secret

# --- COLETA ---
RAPIDAPI_KEY=your_rapidapi_key
META_ACCESS_TOKEN=your_meta_access_token
META_API_VERSION=v19.0
INSTAGRAM_SESSIONID=your_instagram_session
IG_USER=tempareiapodcast
IG_PASS=tempareia102030
APIFY_API_TOKEN=your_apify_token

# --- PROXY (v98.0 — Sticky Proxy Binding) ---
# Opção 1 (RECOMENDADA): Proxy residencial com sticky session por sessão IG
# Cada sessão sempre usa o mesmo IP durante todo o scrape_profile()
# Compatível com Webshare Residential e IPRoyal (~$10-15/mês)
# Formato: http://usuario-session-{SESSION_ID}:senha@proxy.host:porta
PROXY_URL_TEMPLATE=
# Opção 2 (legado): Lista de proxies em roundrobin separados por vírgula
PROXY_LIST=
# Opção 3 (legado): Proxy único fixo para todos os requests
PROXY_URL=

# --- IA ---
GROQ_API_KEY=your_groq_api_key
GEMINI_API_KEY=your_gemini_api_key
MARITACA_API_KEY=your_maritaca_api_key
IA_PROVIDER=hybrid # opçoes: hybrid, gemini, groq, ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
MODEL_EXPERT=gemma:2b
RESEARCHER_MODE=disabled

# --- PUSH NOTIFICATIONS ---
WHATSAPP_PHONE=55... (your phone with country code)
WHATSAPP_API_KEY=your_callmebot_apikey

# --- PAGAMENTOS ---
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_STARTER_PRICE_ID=price_...
STRIPE_SQUAD_PRICE_ID=price_...
STRIPE_WARROOM_PRICE_ID=price_...
STRIPE_ALLOW_MOCK_PAYMENTS=false
FRONTEND_URL=http://localhost:3000

# --- OPCIONAL ---
ABSTRA_API_KEY=your_abstra_api_key
EMERGENT_API_KEY=your_emergent_api_key
ASKCODI_API_KEY=your_askcodi_api_key
AUREO_API_KEY=your_aureo_api_key
