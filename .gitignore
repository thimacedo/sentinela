# =================================================================
# Sentinela Democratica: .gitignore Consolidado (PASA v50)
# =================================================================

# 1. Dependencias e Ambientes
# -----------------------------------------------------------------
# Python
.venv/
venv/
ENV/
env/
.python-version
__pycache__/
*.py[cod]
*$py.class

# NodeJS / Next.js
node_modules/
frontend-bleeding-edge/node_modules/
frontend-bleeding-edge/.next/
.next/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 2. Arquivos de Build e Cache
# -----------------------------------------------------------------
build/
dist/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.eslintcache
.cache/

# 3. Credenciais, Segredos e Sessoes (NUNCA COMMITAR)
# -----------------------------------------------------------------
.env
.env.local
.env.*
.env.development.local
.env.test.local
.env.production.local
*.session
sentinela_ig_session
cookies.txt
api_zyte.txt
*.key
*.pem

# Artefato corrompido
...

# Dados de runtime e snapshots
data/collection_state.json
data/false_positives.json
data/kpi_snapshot*.json
data/lista_alvos_prioridade10.json
data/training_examples.json
metrics/
scraper_weights.json
sentinela_novo/output_test.json

# Relatorios e auditorias geradas
audit_report.json
deep_audit_report.json
final_prod_test_report.json
output_final.json
docs/kpis.json
docs/profiler_stream.json

# Supabase temp
supabase/.temp/

# Sessoes e storage do Playwright/Instagram
configs/instagram_storage_state.json
configs/*.json

# 4. Arquivos Gerados e Logs de Runtime
# -----------------------------------------------------------------
logs/
*.log
*.log.*
*.html
!local_dashboard.html
*.csv
*.db
*.sqlite3
*.xml
*.cpuprofile

# Relatorios e saidas de dados
data/reports/
data/visuals/

# Imagens de erro e screenshots
/falha_*.png
/erro_geral.png

# Estado de runtime
runtime_state/

# 5. Configuracoes de IDE e Sistema Operacional
# -----------------------------------------------------------------
# VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
# Outros
.idea/
*.swp
*.swo
# macOS
.DS_Store
# Windows
Thumbs.db

# 6. Vercel
# -----------------------------------------------------------------
.vercel/
.vercel/output/
.vercel/project.json

# 7. Rascunhos e Diagnostics
scratch/

# 8. Documentos e Pesquisas (NUNCA COMMITAR)
*.pdf
bases_pesquisas/

