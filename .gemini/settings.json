{
  "mcpServers": {
    "browseract": {
      "url": "https://api.browseract.com/mcp",
      "headers": {
        "Authorization": "Bearer $BROWSERACT_API_KEY"
      }
    },
    "huggingface": {
      "url": "https://huggingface.co/mcp",
      "headers": {
        "Authorization": "Bearer $HF_TOKEN"
      }
    }
  },
  "experimental": {
    "gemmaModelRouter": {
      "enabled": true,
      "classifier": {
        "host": "http://localhost:9379",
        "model": "gemma3-1b-gpu-custom"
      }
    }
  }
}